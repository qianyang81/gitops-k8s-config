# Use doublestar globs like **/foo/**
doublestar: true

# Don't touch these "config files" (not Kubernetes manifests)
exclude:
  - "**/kustomization.yaml"
  - "**/values.yaml"
  - "out/**"
  - "**/.github/**"

formatter:
  type: basic
  indent: 2
  include_document_start: true
  retain_line_breaks: true
  line_ending: lf


